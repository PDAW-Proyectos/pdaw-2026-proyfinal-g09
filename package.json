{
  "name": "la-cochera-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "npm test -- --coverage",
    "lint": "eslint server.js src routes middlewares public/js tests",
    "format:check": "prettier --check src/Errores.js middlewares/errores.js tests/errores.test.js eslint.config.js .prettierrc.json",
    "format": "prettier --write src/Errores.js middlewares/errores.js tests/errores.test.js eslint.config.js .prettierrc.json"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.9",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "google-auth-library": "^11.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "supertest": "^7.3.1"
  }
}

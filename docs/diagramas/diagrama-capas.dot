digraph G { graph [bgcolor="#f5f7fb", pad="0.4", nodesep="0.45", ranksep="0.65", fontname="Arial", fontsize=22, fontcolor="#15243b", labelloc=t]; node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6985a8", fontname="Arial", fontsize=14, margin="0.2,0.15"]; edge [color="#597591", fontname="Arial", fontsize=11, fontcolor="#334b65", arrowsize=0.8]; rankdir=TB; label="Arquitectura implementada | Responsabilidades y flujo";
ui [label="NAVEGADOR\npublic: HTML · CSS · JavaScript\nFormularios, fetch, estados y DOM",fillcolor="#dfeaf9"];
server [label="COMPOSICIÓN · server.js\nNode.js + Express · rutas · archivos estáticos"];
mw [label="MIDDLEWARES\nexpress-session · registro de solicitudes\nrequiereSesion → requiereAdmin (rutas protegidas)"];
routes [label="HTTP · routes\nRegistro · Login · Google · Perfil · Noticias · Admin\nValidación de entrada, coordinación y respuestas"];

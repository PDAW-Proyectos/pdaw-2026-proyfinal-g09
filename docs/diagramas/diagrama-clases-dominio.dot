digraph G { graph [bgcolor="#f5f7fb", pad="0.4", nodesep="0.45", ranksep="0.65", fontname="Arial", fontsize=22, fontcolor="#15243b", labelloc=t]; node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6985a8", fontname="Arial", fontsize=14, margin="0.2,0.15"]; edge [color="#597591", fontname="Arial", fontsize=11, fontcolor="#334b65", arrowsize=0.8]; rankdir=TB; label="Clases implementadas | No incluye pagos futuros"; node [shape=record,style=filled,fillcolor="#ffffff",fontsize=12];
Usuario [label="{Usuario|id: string\l- username: string\l- email: string\l- passwordHash: string o null\l- googleId: string o null\l- avatarUrl: string o null\l- esContribuyente: boolean\l- rol: usuario o admin\l|+ actualizarPerfil(username)\l+ actualizarPasswordHash(hash)\l+ actualizarAvatar(url)\l+ habilitarContribuyente()\l+ revocarContribuyente()\l+ puedeJugarDemo()\l+ puedeAccederPanel()\l+ puedeGestionarUsuarios()\l+ toJSON()\l+ paraPersistir()\l}",fillcolor="#dfeaf9"];
Administrador [label="{Administrador|rol fijado en admin\l|+ puedeJugarDemo()\l+ puedeAccederPanel()\l+ puedeGestionarUsuarios()\l+ habilitarAcceso(usuario)\l+ revocarAcceso(usuario)\l}"];
RU [label="{RepositorioUsuarios|ruta\lusuarios: colección\l|+ cargar() / guardar()\l+ restaurar(datos) / listar()\l+ buscarPorId(id)\l+ buscarPorEmail(email)\l+ buscarPorGoogleId(googleId)\l+ agregarUsuario(usuario)\l+ actualizarUsuario(usuario)\l+ actualizarPasswordHash(id, hash)\l}"];
Noticia [label="{Noticia|- id: string\l- titulo: string\l- contenido: string\l- fecha: Date\l- autor: string\l|+ getters\l+ toJSON()\l}",fillcolor="#e3f2e9"];
RN [label="{RepositorioNoticias|- noticias: colección\l- rutaArchivo\l|+ cargar() / guardar()\l+ obtenerTodas()\l+ buscarPorId(id)\l+ agregarNoticia(datos)\l+ actualizarNoticia(id, datos)\l+ eliminarNoticia(id)\l}"];
Error [label="{Error}"]; EH [label="{ErrorHttp|status\lmessage heredado\l}"];
Administrador -> Usuario [arrowhead=empty,label="hereda"]; RU -> Usuario [arrowtail=odiamond,arrowhead=none,dir=both,label="0..* · conserva y restaura"]; RN -> Noticia [arrowtail=odiamond,arrowhead=none,dir=both,label="0..* · conserva y restaura"]; Administrador -> Usuario [style=dashed,label="habilita / revoca",constraint=false]; EH -> Error [arrowhead=empty];
nota [shape=note,label="Google es un método de Usuario.\nNo existe UsuarioGoogle ni Contribucion.\npuedeJugarDemo expresa una regla del modelo;\nla ruta estática del juego aún no la aplica.",fillcolor="#fff2d8"]; {rank=same; RU; RN;} }
